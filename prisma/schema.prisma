  descripcion    String
  fechaHecho     DateTime
  evidenciaUrl   String?   // foto, PDF, correo, registro de asistencia
  emitidaPor     String    // supervisor/admin
  acuseEmpleado  Boolean   @default(false) // el empleado firmó/recibió
  fechaAcuse     DateTime?
  reincidenciaDe String?   // id de acta previa (encadena reincidencias)
  cerrada        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([empleadoId, fechaHecho])
}

model BaseConocimientoLaboral {
