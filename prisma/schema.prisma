  totalDescuento       Decimal                  @default(0)
  totalItbms           Decimal
  totalNeto            Decimal
  estado               String                   @default("pendiente") // pendiente | entregado | facturado | anulado
  pedidoId             String?
  facturaId            String?
  cotizacionId         String?
  firmaClienteUrl      String?
  observaciones        String?
  fechaEstimadaEntrega DateTime?
  fechaRealEntrega     DateTime?
  direccionEntrega     String?
  nombreContacto       String?
