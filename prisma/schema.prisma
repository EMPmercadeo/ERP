// Turno de caja del POS: cada cajero debe abrir un turno (declarando el efectivo inicial)
// antes de poder vender, y cerrarlo al final contando el efectivo real en caja. El cierre
// calcula lo esperado (monto inicial + ventas en efectivo del turno) contra lo contado y
// registra la diferencia (faltante/sobrante) para arqueo de caja.
model TurnoCaja {
  id                  String    @id @default(cuid())
  empresaId           String
  usuarioId           String
  fechaApertura       DateTime  @default(now())
  montoInicial        Decimal
  fechaCierre         DateTime?
  montoContadoCierre  Decimal?
  montoEsperadoCierre Decimal?
  // montoContadoCierre - montoEsperadoCierre (positivo = sobrante, negativo = faltante)
  diferencia          Decimal?
  estado              String    @default("abierto") // abierto | cerrado
  observaciones       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  empresa             Empresa   @relation(fields: [empresaId], references: [id])
  usuario             Usuario   @relation(fields: [usuarioId], references: [id])
  ventas              Venta[]

  @@index([empresaId, estado])
  @@index([usuarioId, estado])
}

model Venta {
  id            String     @id @default(cuid())
  empresaId     String
  empresa       Empresa    @relation(fields: [empresaId], references: [id])
  cuentaId      String?
  cuenta        Cuenta?    @relation(fields: [cuentaId], references: [id])
  turnoCajaId   String?
  turnoCaja     TurnoCaja? @relation(fields: [turnoCajaId], references: [id])
  cufe          String?    @unique
  tipoDoc       String   // 01 factura | 02 boleta
  clienteRuc    String?
  items         Json     // líneas: producto, cantidad, precio, itbms
  subtotal      Decimal
  itbms         Decimal
  total         Decimal
  metodoPago    String   // EFECTIVO | TARJETA | YAPPY | TRANSFERENCIA | MIXTO
  // Numero de referencia/autorizacion del datafono o de la app de Yappy, capturado
  // manualmente por el cajero para poder conciliar despues contra el estado de cuenta del
  // procesador. No hay integracion real con un procesador de pagos (requiere credenciales
  // reales del usuario que hoy no existen) -- ver src/lib/pos/hardwareEscPos.ts.
  referenciaPago String?
  estado        String     @default("LOCAL") // LOCAL | EN_COLA | AUTORIZADA | RECHAZADA | ANULADA
  contingencia  Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([empresaId, createdAt])
  @@index([cuentaId, createdAt])
  @@index([estado, createdAt])
  @@index([turnoCajaId])
}

model ConfiguracionWoo {
  id           String    @id @default(cuid())
  cuentaId     String    @unique
  cuenta       Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  urlTienda    String
  consumerKey  String    @db.Text // cifrada
  consumerSec  String    @db.Text // cifrada
  activo       Boolean   @default(true)
  ultimaSync   DateTime?
}

// Rastrea cada orden creada contra el Botón de Pago Yappy V2, desde que se pide hasta que
// llega la notificación IPN (o expira). Es indispensable para el webhook: la notificación de
// Yappy solo trae orderId/status/hash/domain (nunca el merchantId), así que sin esta tabla no
// habria forma de saber a que empresa (y con que clave secreta validar el hash) pertenece cada
// notificacion entrante.
model YappyOrden {
  id            String    @id // mismo valor que el orderId enviado a Yappy (max 15 alfanumerico)
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  ventaId       String?
  monto         Decimal
  estado        String    @default("PENDIENTE") // PENDIENTE | EJECUTADO | RECHAZADO | CANCELADO | EXPIRADO
  transactionId String?
  createdAt     DateTime  @default(now())
  confirmadoAt  DateTime?

  @@index([empresaId, estado])
}
