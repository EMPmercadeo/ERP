model PlanCuentas {
  id               String                 @id @default(cuid())
  empresaId        String
  codigo           String
  nombre           String
  tipo             String // ACTIVO, PASIVO, PATRIMONIO, INGRESO, GASTO, COSTO
  naturaleza       String // DEUDORA o ACREEDORA
