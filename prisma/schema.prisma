model Empleado {
  id            String                 @id @default(cuid())
  empresaId     String
  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  cuentaId      String?
  cuenta        Cuenta?                @relation(fields: [cuentaId], references: [id])
