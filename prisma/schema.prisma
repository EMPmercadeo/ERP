  productoId  String                 @unique
  activo      Boolean                @default(true)
  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  producto    Producto               @relation(fields: [productoId], references: [id])
  componentes ProductoKitComponente[]

  @@index([empresaId])
}

model ProductoKitComponente {
  id                  String       @id @default(cuid())
  empresaId           String
  productoKitId       String
  productoComponenteId String
  cantidad            Int

  empresa             Empresa      @relation(fields: [empresaId], references: [id])
  productoKit         ProductoKit  @relation(fields: [productoKitId], references: [id])
  productoComponente  Producto     @relation("ProductoComoComponente", fields: [productoComponenteId], references: [id])

  @@unique([productoKitId, productoComponenteId])
  @@index([empresaId])
  @@index([productoComponenteId])
}

// Transferencia de stock entre dos bodegas de la misma empresa. Al crearse (estado
// en_transito) se descuenta el stock de InventarioBodega en la bodega origen de inmediato
// (el producto ya salió físicamente); al recibirse se incrementa en la bodega destino. Si se
// cancela mientras está en_transito, se revierte el descuento en origen. Nunca queda el mismo
// stock "disponible" simultáneamente en dos bodegas mientras el traslado está en curso.
model TransferenciaBodega {
  id              String    @id @default(cuid())
  empresaId       String
  numero          String
  bodegaOrigenId  String
  bodegaDestinoId String
  estado          String    @default("en_transito") // en_transito | recibido | cancelado
  notas           String?
  fechaEnvio      DateTime  @default(now())
  fechaRecepcion  DateTime?
  creadorId       String
  receptorId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  bodegaOrigen    Bodega    @relation("TransferenciasOrigen", fields: [bodegaOrigenId], references: [id])
  bodegaDestino   Bodega    @relation("TransferenciasDestino", fields: [bodegaDestinoId], references: [id])
  creador         Usuario   @relation("TransferenciaBodegaCreador", fields: [creadorId], references: [id])
  receptor        Usuario?  @relation("TransferenciaBodegaReceptor", fields: [receptorId], references: [id])
  items           TransferenciaBodegaItem[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([bodegaOrigenId])
  @@index([bodegaDestinoId])
}

model TransferenciaBodegaItem {
  id              String              @id @default(cuid())
  transferenciaId String
  productoId      String
  cantidad        Int

  transferencia   TransferenciaBodega @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  producto        Producto            @relation(fields: [productoId], references: [id])

  @@index([transferenciaId])
  @@index([productoId])
}

model ConfiguracionFacturacionElectronica {
  id                 String   @id @default(cuid())
  empresaId          String   @unique
  proveedor          String
  ambiente           Int
  baseUrl            String
  authTipo           String
  credencialCifrada  String   @db.Text
  activo             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
}

model FacturaPACLog {
  id               String   @id @default(cuid())
  facturaId        String
  empresaId        String
  tipoOperacion    String
  requestPayload   Json
  responsePayload  Json
  codigoResultado  String?
  mensajeResultado String?
  exitoso          Boolean
  createdAt        DateTime @default(now())
  factura          Factura  @relation(fields: [facturaId], references: [id])
  empresa          Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([facturaId])
}

model Cuenta {
  id               String            @id @default(cuid())
  nombre           String
  empresa          String
  ruc              String            @unique
  correo           String            @unique
  telefono         String?
  estado           String            @default("ACTIVA") // ACTIVA | SUSPENDIDA | BLOQUEADA
  planId           String?
  plan             Plan?             @relation(fields: [planId], references: [id])
  saldoFacturas    Int               @default(0) // Cuotas de facturas electrónicas disponibles
  ultimoAcceso     DateTime?
  // Última vez que se notificó al cliente que tiene saldo de facturas sin usar (inactividad
  // de 3+ meses). Sirve de anti-spam: no se le vuelve a escribir dentro de la ventana de
  // recordatorio. NULL = nunca notificado. El saldo NUNCA se elimina solo; la baja es manual.
  notificadoInactividadEn DateTime?
  eliminadoEn      DateTime?         // soft-delete
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  pagos            PagoCuenta[]
  facturas         FacturaEmitida[]
  movimientosCuota MovimientoCuota[]
  tickets          TicketSoporte[]
  empleados        Empleado[]
  ventas           Venta[]
  configuracionWoo ConfiguracionWoo?

  @@index([correo])
  @@index([ruc])
  @@index([estado, eliminadoEn])
}

model PagoCuenta {
  id          String   @id @default(cuid())
  cuentaId    String
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  planId      String?
  plan        Plan?    @relation(fields: [planId], references: [id])
  monto       Decimal
  metodo      String   // TARJETA | TRANSFERENCIA | YAPPY | OTRO
  estado      String   @default("PENDIENTE") // PAGADO | FALLIDO | REEMBOLSADO | PENDIENTE
  referencia  String   @unique   // id del proveedor de pago (idempotencia)
  createdAt   DateTime @default(now())

  @@index([cuentaId, createdAt])
  @@index([estado, createdAt])
  @@map("PagoCuenta")
}

model FacturaEmitida {
  id         String   @id @default(cuid())
  cuentaId   String
  cuenta     Cuenta   @relation(fields: [cuentaId], references: [id])
  cufe       String?  @unique   // identificador DGI
  cliente    String             // receptor de la factura
  total      Decimal
  itbms      Decimal
  estado     String   @default("ENVIADA") // ACEPTADA | RECHAZADA | ANULADA | ENVIADA
  motivoRech String?
  xmlUrl     String?
  createdAt  DateTime @default(now())

  @@index([cuentaId, createdAt])
  @@index([estado, createdAt])
}

model MovimientoCuota {
  id          String   @id @default(cuid())
  cuentaId    String
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  tipo        String   // CREDITO_COMPRA | DEBITO_EMISION | AJUSTE_MANUAL | REEMBOLSO
  cantidad    Int      // positivo para crédito, negativo para débito
  saldoAnte   Int
  saldoPost   Int
  nota        String?
  referencia  String?  // ID de pago o factura
  createdAt   DateTime @default(now())

  @@index([cuentaId, createdAt])
  @@index([tipo, createdAt])
}

model TicketSoporte {
