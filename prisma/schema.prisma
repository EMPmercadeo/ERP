  // con datos inventados y calcule sobre los colaboradores reales de esta empresa.
  departamento  String                 @default("General")
  frecuenciaPago String                @default("mensual") // mensual | quincenal | bisemanal
  tasaRiesgo    Float                  @default(0.0105)    // tasa de Riesgos Profesionales CSS (0.0105 a 0.0560)
