  totalDebe  Decimal
  totalHaber Decimal
  estado     String                 @default("CONFIRMADO") // BORRADOR, CONFIRMADO, ANULADO
  usuarioId  String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
