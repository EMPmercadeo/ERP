  cedula        String
  cargo         String
  salarioBase   Decimal
  tipoContrato  String                 // INDEFINIDO | DEFINIDO | OBRA
  fechaIngreso  DateTime
  fechaSalida   DateTime?              // soft-delete / baja
  activo        Boolean                @default(true)
