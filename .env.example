# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - ERP PANAMÁ
# ==============================================================================
# Copie este archivo como `.env` o `.env.local` y complete los valores reales.
# ATENCIÓN: No use prefijo NEXT_PUBLIC_ para variables que contengan secretos.
# ==============================================================================

# Aplicación
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# Firebase (Autenticación y Administración)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# App Check (Protección contra Abuso API)
FIREBASE_APP_CHECK_ENABLED=false
FIREBASE_APP_CHECK_KEY=your-firebase-app-check-key

# Base de datos (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:port/dbname?schema=public"

# Storage (LocalStorage, AWS S3 o Vercel Blob)
# Proveedores válidos: local | s3 | vercel
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-aws-s3-bucket-name
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Redis / Rate Limiting (Distributed Limiter)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Observabilidad (Monitoreo de Errores)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Correo SMTP / Mailer
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# WhatsApp Cloud API (Notificaciones al cliente)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# Pasarela Yappy (Bancrédito Panamá)
YAPPY_MERCHANT_ID=your-yappy-merchant-id
YAPPY_SECRET_KEY=your-yappy-secret-key
YAPPY_API_URL=https://api.yappy.pa
YAPPY_IPN_URL=https://yourdomain.com/api/v1/providers/webhooks/yappy

# Pasarela PayPal (Pagos Internacionales)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox

# Facturación electrónica / PAC (Dirección General de Ingresos)
PAC_PROVIDER=efacturapty
PAC_API_URL=https://api.efacturapty.com
PAC_CLIENT_ID=your-pac-client-id
PAC_CLIENT_SECRET=your-pac-client-secret
PAC_WEBHOOK_SECRET=your-pac-webhook-signing-secret
