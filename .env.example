# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - ERP PANAMÁ
# ==============================================================================
# Copie este archivo como `.env` o `.env.local` y complete los valores reales.
# ATENCIÓN: No use prefijo NEXT_PUBLIC_ para variables que contengan secretos.
# ==============================================================================

# Aplicación
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# Seguridad Interna (OBLIGATORIAS)
# ENCRYPTION_KEY: Clave AES-256 de al menos 32 caracteres para cifrar datos sensibles.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars
# SUPERADMIN_CLAIM_CODE: Código secreto para reclamar el rol de superadmin (mín. 8 caracteres).
SUPERADMIN_CLAIM_CODE=your-superadmin-claim-code-min-8-chars

# Firebase Admin SDK (Servidor — OBLIGATORIA en producción)
# JSON completo de la service account descargada desde Firebase Console.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'

# Firebase Client SDK (Navegador — OBLIGATORIAS para login)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# App Check (Protección contra Abuso API)
FIREBASE_APP_CHECK_ENABLED=false
FIREBASE_APP_CHECK_KEY=your-firebase-app-check-key

# Base de datos (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:port/dbname?schema=public"

# Storage (LocalStorage, AWS S3 o Vercel Blob)
# Proveedores válidos: local | s3 | vercel
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-aws-s3-bucket-name
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Redis / Rate Limiting (Distributed Limiter)
# Si RATE_LIMIT_ENABLED=true, el middleware usa Redis para limitar peticiones por IP.
# Sin Redis configurado, el rate limiting usa fallback en memoria local (no distribuido).
RATE_LIMIT_ENABLED=false
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Observabilidad (Monitoreo de Errores)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Correo SMTP / Mailer
# Soporta cualquier proveedor SMTP: Google Workspace, Resend, Zoho, Mailgun, etc.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# WhatsApp Cloud API (Notificaciones al cliente)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# Pasarela Yappy (Bancrédito Panamá)
YAPPY_MERCHANT_ID=your-yappy-merchant-id
YAPPY_SECRET_KEY=your-yappy-secret-key
YAPPY_API_URL=https://api.yappy.pa
YAPPY_IPN_URL=https://yourdomain.com/api/v1/providers/webhooks/yappy

# Pasarela PayPal (Pagos Internacionales)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox

# Facturación electrónica / PAC (Dirección General de Ingresos)
PAC_PROVIDER=efacturapty
PAC_API_URL=https://api.efacturapty.com
PAC_CLIENT_ID=your-pac-client-id
PAC_CLIENT_SECRET=your-pac-client-secret
PAC_WEBHOOK_SECRET=your-pac-webhook-signing-secret
